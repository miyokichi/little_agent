{
  "tools": [
    {
      "name": "create_skill",
      "description": "Create an Agent Skills-format skill folder (SKILL.md with YAML frontmatter) under the workspace skills directory.",
      "script": "scripts/skill_creator.py",
      "requires_confirmation": true,
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name. It is normalized to the Agent Skills rule: lowercase letters, digits and single hyphens (max 64)."
          },
          "description": {
            "type": "string",
            "description": "What the skill does AND when to use it, with keywords that help an agent pick it (max 1024 characters)."
          },
          "include_scripts": {
            "type": "boolean",
            "description": "Create a scripts directory and a sample Python script.",
            "default": false
          },
          "include_references": {
            "type": "boolean",
            "description": "Create a references directory.",
            "default": false
          },
          "include_assets": {
            "type": "boolean",
            "description": "Create an assets directory.",
            "default": false
          },
          "include_tools_manifest": {
            "type": "boolean",
            "description": "Create tools.json for script-backed tools.",
            "default": false
          },
          "overwrite": {
            "type": "boolean",
            "description": "Allow overwriting existing generated files.",
            "default": false
          }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    {
      "name": "validate_skill",
      "description": "Validate a skill folder against the Agent Skills specification (frontmatter fields, naming, tools.json).",
      "script": "scripts/skill_creator.py",
      "requires_confirmation": false,
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill folder name under skills/."
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  ]
}

