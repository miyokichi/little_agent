OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Use a vision-capable model so the screen_capture skill's images can be read.
LITTLE_AGENT_MODEL=gpt-4.1-mini
LITTLE_AGENT_WORKSPACE=.
LITTLE_AGENT_REQUIRE_CONFIRMATION=true
LITTLE_AGENT_MAX_TOOL_STEPS=5
LITTLE_AGENT_TIMEOUT_SECONDS=60
LITTLE_AGENT_ENABLE_LOGGING=true
LITTLE_AGENT_LOG_DIR=logs

# Workflow viewer port (http://127.0.0.1:<port>/). Used by python -m little_agent.viewer
# and the workflow skill's open_workflow_viewer tool.
LITTLE_AGENT_VIEWER_PORT=8765

# Emergency stop hotkey for AI computer operation (pynput GlobalHotKeys format).
# Active only while the agent is acting. Requires pynput (pip install pynput).
LITTLE_AGENT_STOP_HOTKEY=<ctrl>+<alt>+q

# Master memory paths
# Workspace memory is always {LITTLE_AGENT_WORKSPACE}/memory.md (not configurable)
# Global memory is shared across all agents and workspaces
LITTLE_AGENT_GLOBAL_MEMORY_PATH=~/.little_agent/memory.md

# Auto-learning (Reflection): distill durable user/workspace profiles from each
# session and reuse them next time. Runs at session end and on the /remember
# command. Requires an LLM (OPENAI_API_KEY); skipped in local-fallback mode.
# Workspace profile is always {LITTLE_AGENT_WORKSPACE}/profile.md (not configurable).
LITTLE_AGENT_AUTO_LEARNING=true
LITTLE_AGENT_GLOBAL_PROFILE_PATH=~/.little_agent/profile.md
