OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Use a vision-capable model so the screen_capture skill's images can be read.
LITTLE_AGENT_MODEL=gpt-4.1-mini
LITTLE_AGENT_WORKSPACE=.
LITTLE_AGENT_REQUIRE_CONFIRMATION=true
LITTLE_AGENT_MAX_TOOL_STEPS=5
LITTLE_AGENT_TIMEOUT_SECONDS=60
LITTLE_AGENT_ENABLE_LOGGING=true
LITTLE_AGENT_LOG_DIR=logs

# Workflow viewer port (http://127.0.0.1:<port>/). Used by python -m little_agent.viewer
# and the workflow skill's open_workflow_viewer tool.
LITTLE_AGENT_VIEWER_PORT=8765

# Filesystem task harness (skills/workspace_harness). Task = folder under tasks/,
# with human-controlled top-level areas. shared/ holds common materials the agent
# searches autonomously. LITTLE_AGENT_SHARED_DIR may be an absolute path outside
# the workspace.
LITTLE_AGENT_TASKS_DIR=tasks
LITTLE_AGENT_SHARED_DIR=shared

# Emergency stop hotkey for AI computer operation (pynput GlobalHotKeys format).
# Active only while the agent is acting. Requires pynput (pip install pynput).
LITTLE_AGENT_STOP_HOTKEY=<ctrl>+<alt>+q

# Master memory paths
# Workspace memory is always {LITTLE_AGENT_WORKSPACE}/memory.md (not configurable)
# Global memory is shared across all agents and workspaces
LITTLE_AGENT_GLOBAL_MEMORY_PATH=~/.little_agent/memory.md

# Slash command directories
# Project commands live in {LITTLE_AGENT_WORKSPACE}/commands/*.md by default.
# Global commands are shared across all workspaces.
LITTLE_AGENT_COMMANDS_DIR=commands
LITTLE_AGENT_GLOBAL_COMMANDS_DIR=~/.little_agent/commands

# Agent profiles
# skills/ is the skill library (master copies). Each agent under agents/<name>/
# has its own skills/ copied from the library and an agent.json profile.
# LITTLE_AGENT_AGENT selects the agent to run at startup (overridable by --agent).
LITTLE_AGENT_SKILL_LIBRARY_DIR=skills
LITTLE_AGENT_AGENTS_DIR=agents
LITTLE_AGENT_AGENT=
# A2A (Agent2Agent) delegation via the delegate_task / delegate_tasks core
# tools. Max hand-off depth; 0 disables delegation entirely.
LITTLE_AGENT_MAX_DELEGATION_DEPTH=2

# How many subtasks delegate_tasks runs at the same time. Extra subtasks queue
# behind the running ones.
LITTLE_AGENT_MAX_PARALLEL_DELEGATIONS=4

# Remote A2A peers available to delegate_task, as name=url pairs.
# Any A2A-compliant agent works, not just another Little Agent. A local agents/
# profile name needs no entry here: its A2A server is started on demand.
# LITTLE_AGENT_A2A_PEERS=office=http://127.0.0.1:8801/,research=http://10.0.0.5:9000/

# Shared bearer token for A2A. When set, this agent's server requires it and the
# client sends it to peers. The Agent Card stays public so peers can discover it.
# LITTLE_AGENT_A2A_TOKEN=

# An A2A server has no human to answer confirmation prompts, so tools that need
# confirmation (write_file, run_powershell, ...) are denied unless this is true.
LITTLE_AGENT_A2A_AUTO_APPROVE=false
# Auto-learning (Reflection): distill durable user/workspace profiles from each
# session and reuse them next time. Runs at session end and on the /remember
# command. Requires an LLM (OPENAI_API_KEY); skipped in local-fallback mode.
# Workspace profile is always {LITTLE_AGENT_WORKSPACE}/profile.md (not configurable).
LITTLE_AGENT_AUTO_LEARNING=true
LITTLE_AGENT_GLOBAL_PROFILE_PATH=~/.little_agent/profile.md
